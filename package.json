{
    "name": "anomaly-workspace",
    "description": "Anomaly language parser and interpreter",
    "version": "0.0.1",
    "type": "module",
    "private": true,
    "scripts": {
        "clean": "shx rm -rf out",
        "watch": "tsc -p tsconfig.build.json --watch",
        "build": "npm run langium:generate && tsc -p tsconfig.build.json",
        "build:clean": "npm run clean && npm run build",
        "langium:generate": "langium generate",
        "langium:watch": "langium generate --watch",
        "pretest": "npm run langium:generate",
        "test": "vitest run",
        "demo": "tsx src/test-anomaly.ts"
    },
    "devDependencies": {
        "@types/node": "~20.19.43",
        "shx": "~0.4.0",
        "tsx": "^4.23.15",
        "typescript": "~5.9.3",
        "vitest": "^4.1.12",
        "langium-cli": "~4.4.0"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "fsevents@2.3.3": true
    },
    "dependencies": {
        "langium": "~4.4.0"
    }
}
